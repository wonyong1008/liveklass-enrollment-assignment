# docker-compose.yml 이 이 파일을 읽어 컨테이너에 주입한다.
# 실제 실행 전 `cp .env.example .env` 로 복사해서 사용할 것 (.env는 git에 커밋하지 않음).

MYSQL_DATABASE=enrollment
MYSQL_USER=enrollment
MYSQL_PASSWORD=enrollment1234
MYSQL_ROOT_PASSWORD=root1234

# HS256 서명 키. 운영 환경에서는 반드시 32바이트 이상의 무작위 값으로 교체할 것.
JWT_SECRET=liveklass-assignment-local-dev-secret-key-please-rotate
